{
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Artifact",
      "Bash(node scripts/backlog.mjs:*)",
      "Bash(node scripts/check-readiness.mjs:*)",
      "Bash(npm run check:readiness:*)",
      "Bash(npm run check:standards:*)",
      "Edit(/.claude/commands/**)",
      "Edit(/skills-src/**)",
      "Edit(/.claude/skills/batch-backlog-items/**)",
      "Edit(~/.claude/skills/closing-session/**)",
      "Edit(/.claude/skills/next-backlog-item/**)",
      "Bash([ -s \"$f\" ])",
      "Edit(/.claude/skills/review-program/**)",
      "Bash(rm -f .git/GAPSWEEP_MSG.txt)",
      "Bash(git status *)",
      "Edit(/.claude/skills/prepare-decision-item/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/bootstrap-session.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-lane.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/lint-locus-prefix.mjs --pre"
          },
          {
            "type": "command",
            "command": "node scripts/check-memory.mjs --pre"
          },
          {
            "type": "command",
            "command": "node scripts/backlog-guard.mjs --pre"
          },
          {
            "type": "command",
            "command": "node scripts/guard-backward-edge.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-bash.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lint-locus-prefix.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/readiness/record-touch.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/backlog-guard.mjs"
          }
        ]
      }
    ]
  }
}
