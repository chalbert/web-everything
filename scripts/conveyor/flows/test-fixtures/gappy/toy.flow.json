{
  "id": "toy",
  "title": "Toy fix flow with deliberate gaps",
  "summary": "Test fixture. Each gap is labelled in notes.",
  "entry": { "state": "queued", "provides": [ { "kind": "env", "name": "PATH", "cite": "fixture" } ] },
  "states": [
    { "id": "queued", "owner": "toy-daemon", "ownerCite": "fixture:1" },
    { "id": "spawned", "owner": "toy-daemon" },
    { "id": "retargeted", "owner": "toy-daemon", "notes": "path that skips the CI trigger" },
    { "id": "awaiting-ci", "owner": "none", "wait": { "for": "CI", "timeout": null, "onTimeout": null }, "notes": "GAP no-owner + unbounded-wait" },
    { "id": "retrying", "owner": "toy-daemon", "retries": { "what": "push", "cap": null, "onCap": null }, "notes": "GAP uncapped-retry" },
    { "id": "stuck", "owner": "toy-daemon", "notes": "GAP failure-no-exit (no outgoing)" },
    { "id": "orphan", "owner": "toy-daemon", "notes": "GAP unreachable" },
    { "id": "merged", "terminal": true, "outcome": "success" },
    { "id": "failed", "terminal": true, "outcome": "failure", "notes": "GAP silent-failure" }
  ],
  "transitions": [
    { "from": "queued", "to": "spawned", "on": "dispatch" },
    { "from": "queued", "to": "retargeted", "on": "base merged" },
    { "from": "spawned", "to": "awaiting-ci", "on": "pushed" },
    { "from": "retargeted", "to": "awaiting-ci", "on": "base retargeted to main" },
    { "from": "awaiting-ci", "to": "merged", "on": "green" },
    { "from": "awaiting-ci", "to": "retrying", "on": "red", "kind": "failure" },
    { "from": "retrying", "to": "awaiting-ci", "on": "re-pushed" },
    { "from": "retrying", "to": "stuck", "on": "gave up", "kind": "failure" },
    { "from": "orphan", "to": "failed", "on": "x" },
    { "from": "spawned", "to": "@elsewhere", "on": "hand-off to a flow that does not exist" },
    { "from": "spawned", "to": "nowhere", "on": "GAP dangling-ref" }
  ],
  "steps": [
    { "id": "spawn", "state": "spawned", "actor": "toy-daemon", "canFail": true, "onFailure": null,
      "assumes": [ { "kind": "env", "name": "PATH" } ],
      "provides": [ { "kind": "cwd", "name": "<scratch>" } ],
      "notes": "GAP failure-no-exit; does NOT provide permission:edit:<lane>" },
    { "id": "edit", "state": "spawned", "actor": "session",
      "assumes": [ { "kind": "permission", "name": "edit:<lane>" } ],
      "provides": [ { "kind": "ci", "name": "required checks ran on head" } ] },
    { "id": "await", "state": "awaiting-ci", "actor": "none",
      "assumes": [ { "kind": "ci", "name": "required checks ran on head" } ],
      "notes": "the retarget path never provides it" }
  ]
}
