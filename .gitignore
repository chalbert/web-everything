node_modules/
_site/
_site-visual-fixtures/
dist/
coverage/
playwright-report/
test-results/
.DS_Store
.env
.env.local
.env.*.local
.cloudflare.env
.browser-selection.json

# Parcel build cache (trait-enforcer #787 conformance harness)
.parcel-cache/

# Build sourcemaps (emitted alongside compiled output, never committed)
*.js.map
*.d.ts.map

# Publish-built compiled output emitted next to sources in package planes (#2085)
# — these packages ship .ts sources directly (contracts/package.json files: ['*.ts'])
contracts/**/*.js
contracts/**/*.d.ts
capability-manifest/**/*.js
capability-manifest/**/*.d.ts
error-summary/**/*.js
error-summary/**/*.d.ts
commitment-policy/**/*.js
commitment-policy/**/*.d.ts
.claude/lane-ports.json
# Delivery-agent learnings drop-box (#2614) — transient per-session capture (like claims.json). Agents
# append generalized-lesson entries during a session; the /closing-session sweep consumes it at close. Never
# committed — it holds pre-vetting, pre-dedup entries that the sweep + red-team curate before anything lands.
.conveyor/learnings/
# Session-local conveyor CLEAR-FOR-BUILD queue (#2613) — the operator's "clear this item for the conveyor
# to pull" gesture. Session-local operator INTENT, not committed repo state (distinct from committed
# `buildQueued` frontmatter), so it rides a gitignored sidecar the lane guard does not police — that is what
# lets the operator clear work from the MAIN session (see scripts/conveyor/queue.mjs). Never committed.
.conveyor/queue.json
# Dispatch-signal sidecar (#2680) — the ephemeral "small signal, not a durable store" that makes conveyor
# authoring measurable (dispatch → first-commit stamps the `gh`/backlog verbs cannot see). Machine-local,
# recreated on demand by `conveyor-instrument.mjs mark-dispatch`/`mark-setup`; never committed, like queue.json.
.conveyor/dispatch-log.json
# Session-local conveyor INFRA-BLOCKED state (#2659) — a delivery/prepare agent that PUSHED its lane ref but
# hit a PR-open failure on an outside dependency (a GitHub outage) records the resumable handle here; the
# conveyor auto-retries + resume-opens once infra recovers. Operational recovery state, never committed.
.conveyor/infra-blocked.json
# False-green evidence sidecar (#2681) — the diff-driven test-selection shadow full-suite compare records each
# sample (was a full-suite failure OUTSIDE the shrink's selected set?) here. Ephemeral measure-mode evidence the
# eventual default-on decision reads; machine/CI-local, recreated on demand, never committed.
.conveyor/false-green-log.json
# Red-main dispatch-freeze marker (#2681) — present ⇒ the sole writer STOPS THE LINE (main is red). Operational
# stop-the-line state raised/lifted by red-main-remediation.mjs; machine-local, never committed.
.conveyor/red-main-freeze.json
# …and its advisory lock (serializes concurrent record/retry writes) — ephemeral (created+unlinked per
# critical section), but ignore it so a crashed holder's leftover lock never shows as an untracked file.
.conveyor/*.lock
# Durable append-only JURY event log (#2641) — one .jsonl per review subject; the review pipeline appends events
# and the shared fold (we:scripts/lib/jury-ledger.mjs) reconstructs the live jury tree the conveyor + #2642
# console render. Operational observability state (the #2612 single source of truth), machine-local, never committed.
.conveyor/jury/
# Durable per-fork MICRO-DECISION log (#2665) — one .jsonl per review subject; the read port appends a record
# per human action on a fork (challenge/ask/annotate) and the surface fold reconstructs it, mirroring the jury
# sidecar above. Operational state (machine-local), recreated on demand, never committed.
.conveyor/micro-decisions/
# Per-session runtime bookkeeping (TTL'd, machine-local) — tooling recreates on demand (#952).
# SoT relocated to skills-src/ (#2266), so ignore the real path; capacity.json is durable calibration → stays tracked.
skills-src/batch-backlog-items/claims.json
skills-src/batch-backlog-items/queued.json
skills-src/batch-backlog-items/reservations.json
skills-src/batch-backlog-items/prepare-hold.json
skills-src/batch-backlog-items/id-ledger.json
# Review-escalation park-age clock (#2262) — local, machine-scoped, safe to lose (a PR just re-parks fresh)
# Both the built skill dir and the skills-src/ source dir the drain writes from (the source path leaked to the primary).
.claude/skills/drain/review-park-state.json
skills-src/drain/review-park-state.json
# First-drain-sighting manifest baseline (#2414) — same machine-scoped, safe-to-lose cache as the park-age
# clock above, and same skills-src/ source-path leak. Untracked → dirtied the daemon clone every pass, firing a
# false "recovering from interrupted pass" reset; ignoring it also lets the tamper baseline persist cross-pass.
.claude/skills/drain/review-baseline-state.json
skills-src/drain/review-baseline-state.json
